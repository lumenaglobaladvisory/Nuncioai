# --- Database ---
# Postgres is required (Vercel Postgres/Neon/Supabase/local). `npm run build`
# runs `prisma migrate deploy` against this URL, and Vercel's serverless
# functions have no persistent filesystem, so SQLite doesn't work here even
# for a single-instance deploy.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inboxpilot"
# Direct (unpooled) connection, used only for running migrations - see
# prisma/schema.prisma's `directUrl`. If your provider pools DATABASE_URL
# (e.g. Neon's default `-pooler` host), this must point at the non-pooled
# host or `prisma migrate deploy` can hang and fail with P1002. On Neon this
# is provided automatically as DATABASE_URL_UNPOOLED; for local/unpooled
# Postgres it can be the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/inboxpilot"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Vercel (and most PaaS platforms) sit behind a reverse proxy; Auth.js needs
# this explicitly set in production or every sign-in fails with
# "UntrustedHost" / the generic "server configuration" error page. Already
# set in auth.ts (trustHost: true) - listed here only as a reminder of why.
# AUTH_TRUST_HOST=true

# --- Google OAuth (Gmail + Google Calendar) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API and Google Calendar API for the project.
# Scopes needed: gmail.readonly gmail.modify gmail.compose calendar.events
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft Entra ID OAuth (Outlook Mail + Calendar via Graph) ---
# Register an app at https://entra.microsoft.com (App registrations)
# API permissions needed: Mail.ReadWrite, Mail.Send, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- Anthropic (Claude) ---
# Without this set, InboxPilot falls back to a deterministic rule-based
# triage/drafting stub so the app still works end-to-end for local demo.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Policy cron endpoint ---
# Shared secret an external scheduler (e.g. Vercel Cron, GitHub Actions) must
# send as `Authorization: Bearer <secret>` to POST /api/cron/policies
CRON_SECRET="replace-with-a-random-secret"
