# --- Database ---
# SQLite works out of the box for local dev/demo. Swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Gmail + Google Calendar) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API and Google Calendar API for the project.
# Scopes needed: gmail.readonly gmail.modify gmail.compose calendar.events
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft Entra ID OAuth (Outlook Mail + Calendar via Graph) ---
# Register an app at https://entra.microsoft.com (App registrations)
# API permissions needed: Mail.ReadWrite, Mail.Send, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- Anthropic (Claude) ---
# Without this set, InboxPilot falls back to a deterministic rule-based
# triage/drafting stub so the app still works end-to-end for local demo.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Policy cron endpoint ---
# Shared secret an external scheduler (e.g. Vercel Cron, GitHub Actions) must
# send as `Authorization: Bearer <secret>` to POST /api/cron/policies
CRON_SECRET="replace-with-a-random-secret"
